<Window x:Class="EasyPass.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsWindowTitle}" Width="560" Height="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14,24,16">
            <Button Content="{DynamicResource Close}" HorizontalAlignment="Right" IsCancel="True" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="{DynamicResource Settings}" Style="{StaticResource Title}" />

                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LanguageTitle}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="EnglishButton" Tag="en" Content="English" MinWidth="110" Click="Language_Click" />
                            <Button x:Name="RussianButton" Tag="ru" Content="Русский" MinWidth="110" Margin="8,0,0,0" Click="Language_Click" />
                            <Button x:Name="TurkishButton" Tag="tr" Content="Türkçe" MinWidth="110" Margin="8,0,0,0" Click="Language_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource VaultFile}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
                        <TextBox x:Name="VaultPathBox" IsReadOnly="True" Background="{StaticResource Surface2Brush}" />
                        <Button Content="{DynamicResource OpenOther}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenOther_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ChromeTitle}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ChromeStatus" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource ExtFolder}" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button Content="{DynamicResource OpenFolder}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OpenExtensionFolder_Click" />
                            <TextBox x:Name="ExtensionPathBox" IsReadOnly="True" Background="{StaticResource Surface2Brush}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"
                                   Text="{DynamicResource ExtHint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
