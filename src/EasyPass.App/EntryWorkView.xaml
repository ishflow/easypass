<UserControl x:Class="EasyPass.App.EntryWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- This month's work for the open client; rows are built in code (EntryWorkView.xaml.cs) -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource Radius}" Padding="12,10" Margin="0,0,0,8">
        <StackPanel TextBlock.FontSize="13">
            <TextBlock x:Name="Heading" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="EmptyText" Text="{DynamicResource WorkNoTasks}" Style="{StaticResource Secondary}" FontSize="12" Visibility="Collapsed" />
            <StackPanel x:Name="Rows" />
            <DockPanel x:Name="Actions" Margin="0,4,0,0">
                <TextBlock x:Name="EditLink" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center">
                    <Hyperlink Foreground="{StaticResource AccentBrush}" Click="EditList_Click"><Run Text="{DynamicResource WorkEditList}" /></Hyperlink>
                </TextBlock>
                <Button x:Name="SaveButton" Content="{DynamicResource WorkSave}" Style="{StaticResource AccentButton}" Height="28" Padding="14,0"
                        HorizontalAlignment="Left" Click="Save_Click" />
                <!-- shown for a second after each save; no click, no focus -->
                <TextBlock x:Name="SavedMark" Text="{DynamicResource WorkSaved}" Foreground="{StaticResource SuccessBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
