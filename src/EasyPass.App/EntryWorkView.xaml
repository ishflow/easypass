<UserControl x:Class="EasyPass.App.EntryWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- This month's work for the open client; rows are built in code (EntryWorkView.xaml.cs) -->
    <Border Style="{StaticResource Band}">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="EditLink" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{DynamicResource WorkEditList}" FontSize="12"
                        VerticalAlignment="Center" Margin="8,0,0,0" Click="EditList_Click" />
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" Style="{StaticResource Section}" Margin="0,0,10,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock x:Name="Progress" Style="{StaticResource NumText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource WorkNoTasks}" Style="{StaticResource Secondary}" FontSize="12" Visibility="Collapsed" />
            <StackPanel x:Name="Rows" />
            <StackPanel x:Name="Actions" Margin="0,10,0,0">
                <DockPanel>
                    <Button x:Name="AddLink" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="{DynamicResource TaskAdd}" VerticalAlignment="Center" Click="AddTasks_Click" />
                    <Button x:Name="SaveButton" Content="{DynamicResource WorkSave}" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Right" Margin="16,0,0,0" Click="Save_Click" />
                </DockPanel>
                <!-- its own line, always there (Hidden, not Collapsed): shown for a second after each save, nothing moves; no click, no focus -->
                <TextBlock x:Name="SavedMark" Text="{DynamicResource WorkSaved}" Foreground="{StaticResource DoneInkBrush}" FontSize="12" HorizontalAlignment="Right"
                           Margin="0,4,0,0" Visibility="Hidden" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
