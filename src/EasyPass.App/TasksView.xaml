<UserControl x:Class="EasyPass.App.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel MaxWidth="720" HorizontalAlignment="Stretch" Margin="24,16">
        <Button x:Name="AddTask" DockPanel.Dock="Top" Content="{DynamicResource TaskAdd}" Style="{StaticResource AccentButton}"
                HorizontalAlignment="Left" Margin="0,0,0,12" Click="AddTask_Click" />
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="{DynamicResource TaskEmpty}" Style="{StaticResource Secondary}" Visibility="Collapsed" />
        <ListBox x:Name="TaskList" Padding="0" />
    </DockPanel>
</UserControl>
