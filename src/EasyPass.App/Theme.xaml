<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- D "Рабочий месяц". Type scale 11/12/13/15/20, 4 px grid, window text 13.
         Brushes   Background Surface Surface2 Surface3 Line Line2 Hair Text TextSecondary TextTertiary(decor only, under 4.5:1)
                   Accent AccentHover AccentLight AccentLine Danger DangerLight
                   Success DoneTint DoneInk Warning(fill only) WarnInk(text) WarnTint WarnLine OnWarn NoneTint
         Radii     Radius1(6) Radius(8) Radius3(10)
         Text      Title Heading Section Label Secondary Caption Error NumText
         Surfaces  Card(padded) Pane(no padding) Band Hairline Badge+BadgeText PillDone PillWarn PillNone
         Buttons   (implicit=secondary) AccentButton DangerButton GhostButton SmallButton IconButton XButton LinkButton Chip ChipOn
         Status    SegGroup + SegButton SegDoneOn SegWarnOn; GlyphDone GlyphPartial GlyphNone + StatusGlyph / StatusGlyphSmall; BrandMark
         Reminder  ReminderBox + ReminderUnitGroup + ReminderUnit ReminderUnitOn
         Effects   ShadowPop ShadowFloat. Implicit: TextBox PasswordBox ComboBox CheckBox ListBox(Item) TabControl TabItem ScrollBar ToolTip.
         Details: briefs/TASARIM-S1.md -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="#F2F3F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="LineBrush" Color="#E3E6EC" />
    <SolidColorBrush x:Key="Line2Brush" Color="#D3D8E1" />
    <SolidColorBrush x:Key="HairBrush" Color="#1416191F" />
    <SolidColorBrush x:Key="TextBrush" Color="#16191F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6372" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A93A2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3449C8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2A3CAE" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#EEF0FB" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#C7CDF2" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FDECEA" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7A3C" />
    <SolidColorBrush x:Key="DoneTintBrush" Color="#E4F3EA" />
    <SolidColorBrush x:Key="DoneInkBrush" Color="#0C6A33" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F08A1D" />
    <SolidColorBrush x:Key="WarnInkBrush" Color="#9A4B00" />
    <SolidColorBrush x:Key="WarnTintBrush" Color="#FFF0DF" />
    <SolidColorBrush x:Key="WarnLineBrush" Color="#F3C38B" />
    <SolidColorBrush x:Key="OnWarnBrush" Color="#2B1700" />
    <SolidColorBrush x:Key="NoneTintBrush" Color="#F0F2F5" />

    <!-- Relative on purpose: WPF splits family lists on single commas, which would cut a pack://application:,,, address -->
    <FontFamily x:Key="UiFont">/EasyPass;component/Fonts/#Onest, Segoe UI Variable Text, Segoe UI</FontFamily>
    <CornerRadius x:Key="Radius1">6</CornerRadius>
    <CornerRadius x:Key="Radius">8</CornerRadius>
    <CornerRadius x:Key="Radius3">10</CornerRadius>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <DropShadowEffect x:Key="ShadowPop" Color="#16191F" Direction="270" ShadowDepth="8" BlurRadius="24" Opacity="0.18" />
    <DropShadowEffect x:Key="ShadowFloat" Color="#16191F" Direction="270" ShadowDepth="16" BlurRadius="40" Opacity="0.22" />

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Icon" Value="pack://application:,,,/EasyPass;component/app.ico" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <!-- Onest ships unhinted: Display mode would snap its widths and space the text unevenly -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- Keyboard focus only; a mouse click does not draw it -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="6" RadiusY="6" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text -->
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="Error" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style x:Key="NumText" TargetType="TextBlock">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="Pane" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="Band" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource NumText}">
        <Setter Property="Foreground" Value="{StaticResource OnWarnBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PillBase" TargetType="Border">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="6,3,8,3" />
    </Style>
    <Style x:Key="PillDone" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="{StaticResource DoneTintBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource DoneInkBrush}" />
    </Style>
    <Style x:Key="PillWarn" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="{StaticResource WarnTintBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource WarnInkBrush}" />
    </Style>
    <Style x:Key="PillNone" TargetType="Border" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="{StaticResource NoneTintBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Status language: shape and colour together, never colour alone. Use with an Image and give it an AutomationProperties.Name -->
    <DrawingImage x:Key="GlyphDone" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H14 V14 H0 Z" />
                <GeometryDrawing Brush="#0F7A3C">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="7,7" RadiusX="6.5" RadiusY="6.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M4,7.2 L6,9.2 L10,4.8">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="GlyphPartial" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H14 V14 H0 Z" />
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#D9720E" Thickness="1.6" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="7,7" RadiusX="6" RadiusY="6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F08A1D" Geometry="M7,1.8 A5.2,5.2 0 0 0 7,12.2 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="GlyphNone" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H14 V14 H0 Z" />
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8A93A2" Thickness="1.6">
                            <!-- WPF dashes count in pen widths: 2.4 and 2.2 px at 1.6 -->
                            <Pen.DashStyle>
                                <DashStyle Dashes="1.5 1.375" />
                            </Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="7,7" RadiusX="6" RadiusY="6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <Style x:Key="StatusGlyph" TargetType="Image">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusGlyphSmall" TargetType="Image" BasedOn="{StaticResource StatusGlyph}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>
    <DrawingImage x:Key="BrandMark" po:Freeze="True">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#3449C8">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,18,18" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="7.2,9" RadiusX="2.4" RadiusY="2.4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M9.6,9 H13.8 M12.2,9 V11">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="1.4" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!-- 16x16, draw with a Path Stroke of 1.4 and round caps -->
    <GeometryGroup x:Key="GearIcon">
        <EllipseGeometry Center="8,8" RadiusX="2.4" RadiusY="2.4" />
        <PathGeometry Figures="M8,1.8 V3.5 M8,12.5 V14.2 M1.8,8 H3.5 M12.5,8 H14.2 M3.6,3.6 L4.8,4.8 M11.2,11.2 L12.4,12.4 M3.6,12.4 L4.8,11.2 M11.2,4.8 L12.4,3.6" />
    </GeometryGroup>

    <!-- Input boxes. The focus ring sits outside the box, so focus never moves the layout -->
    <ControlTemplate x:Key="InputTemplate" TargetType="Control">
        <Grid>
            <Border x:Name="Ring" Margin="-3" BorderBrush="{StaticResource AccentLightBrush}" BorderThickness="3" CornerRadius="9" Visibility="Hidden" />
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius1}">
                <!-- No Padding margin here: TextBox and PasswordBox hand their Padding to this ScrollViewer themselves -->
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="InputBase" TargetType="Control">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource InputTemplate}" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- Editable combo box (the Site field) -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Ring" Margin="-3" BorderBrush="{StaticResource AccentLightBrush}" BorderThickness="3" CornerRadius="9" Visibility="Hidden" />
                        <Border x:Name="Frame" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource Line2Brush}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius1}" />
                        <ToggleButton Focusable="False" ClickMode="Press" HorizontalAlignment="Right" Width="28"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path Data="M0,0 L3,3 L6,0" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="1,1,28,1" Padding="9,0"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 Foreground="{TemplateBinding Foreground}" SelectionBrush="{StaticResource AccentBrush}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius}" Margin="0,4,0,0" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="{StaticResource Radius1}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Box" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="5" Margin="0,9,10,0" VerticalAlignment="Top"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1.5">
                            <Path x:Name="Tick" Data="M3.5,8 L6.5,11 L12,5" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Margin="-1" Visibility="Hidden" />
                        </Border>
                        <!-- a long task name wraps; the box stays on its first line -->
                        <ContentPresenter VerticalAlignment="Center" Margin="0,9">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons. Tag = hover fill -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius1}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Tag" Value="{StaticResource Surface2Brush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius1}">
                        <Grid>
                            <!-- the inset top light from D's primary button -->
                            <Rectangle Height="1" VerticalAlignment="Top" Margin="1,0" Fill="#24FFFFFF" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Tag" Value="{StaticResource Surface3Brush}" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="Tag" Value="{StaticResource DangerLightBrush}" />
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Icon-only buttons need AutomationProperties.Name and a ToolTip -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="XButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" Background="Transparent" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Text" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reminder chips and the custom field. The custom field must read as an input box, never as a chip -->
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="Tag" Value="{StaticResource Surface3Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipOn" TargetType="Button" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="ReminderBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Ring" Margin="-3" BorderBrush="{StaticResource AccentLightBrush}" BorderThickness="3" CornerRadius="7,0,0,7" Visibility="Hidden" />
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,0,0,4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Frame" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented groups: a ContentControl holding a horizontal StackPanel of the buttons below. Tag = corner radius -->
    <Style x:Key="SegGroup" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="Tag" Value="{StaticResource Radius1}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Mask" Background="{StaticResource SurfaceBrush}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!-- no right margin: the last button's divider lands on the frame's right edge -->
                        <ContentPresenter Margin="1,1,0,1">
                            <ContentPresenter.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=Mask}" />
                            </ContentPresenter.OpacityMask>
                        </ContentPresenter>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" IsHitTestVisible="False"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="SegTemplate" TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="SegButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
        <Setter Property="Template" Value="{StaticResource SegTemplate}" />
    </Style>
    <Style x:Key="SegDoneOn" TargetType="Button" BasedOn="{StaticResource SegButton}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag" Value="{StaticResource SuccessBrush}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" Data="M2.5,6.4 L4.7,8.6 L9.5,3.6" Stroke="White" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <ContentPresenter Content="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegWarnOn" TargetType="Button" BasedOn="{StaticResource SegButton}">
        <Setter Property="Background" Value="{StaticResource WarningBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnWarnBrush}" />
        <Setter Property="Tag" Value="{StaticResource WarningBrush}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Stroke="{StaticResource OnWarnBrush}" StrokeThickness="1.5" />
                            <Path Data="M6,1.4 A4.6,4.6 0 0 0 6,10.6 Z" Fill="{StaticResource OnWarnBrush}" />
                        </Grid>
                        <ContentPresenter Content="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <CornerRadius x:Key="ReminderUnitRadius">0,4,4,0</CornerRadius>
    <Style x:Key="ReminderUnitGroup" TargetType="ContentControl" BasedOn="{StaticResource SegGroup}">
        <Setter Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="Tag" Value="{StaticResource ReminderUnitRadius}" />
    </Style>
    <Style x:Key="ReminderUnit" TargetType="Button" BasedOn="{StaticResource SegButton}">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="Tag" Value="{StaticResource Surface3Brush}" />
    </Style>
    <Style x:Key="ReminderUnitOn" TargetType="Button" BasedOn="{StaticResource ReminderUnit}">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- List rows: 44 px -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{StaticResource Radius1}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentLightBrush}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs: 44 px strip on the window background; the content sits below it, inset 10 px, as D's panes -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="{TemplateBinding Padding}">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="10,0,10,10" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Tab" Background="Transparent" Height="44">
                        <ContentPresenter ContentSource="Header" Margin="12,0" VerticalAlignment="Center" />
                        <Border x:Name="Line" Height="2" Margin="12,0" VerticalAlignment="Bottom" CornerRadius="2,2,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Thin scroll bars, no arrows; clicking the track still pages -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Margin="2" CornerRadius="3" Background="{StaticResource Line2Brush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TextTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TextTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" MinHeight="24" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" MinWidth="24" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource TextBrush}" CornerRadius="{StaticResource Radius1}" Padding="8,4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Month line: the month, then a pill per task with its status glyph -->
    <DataTemplate x:Key="TaskMarkTemplate">
        <Border x:Name="Pill" Style="{StaticResource PillWarn}" Margin="0,0,6,4">
            <DockPanel>
                <Image x:Name="Mark" DockPanel.Dock="Left" Source="{StaticResource GlyphPartial}" Style="{StaticResource StatusGlyphSmall}" Margin="0,2,5,0" VerticalAlignment="Top"
                       AutomationProperties.Name="{Binding Glyph}" />
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Done}" Value="True">
                <Setter TargetName="Pill" Property="Style" Value="{StaticResource PillDone}" />
                <Setter TargetName="Mark" Property="Source" Value="{StaticResource GlyphDone}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="MonthMarksTemplate">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Month}" FontSize="12" Width="110" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,3,8,0" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Tasks}" Focusable="False" ItemTemplate="{StaticResource TaskMarkTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
