<Window x:Class="EasyPass.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyPass" Width="360" Height="144" Style="{StaticResource AppWindow}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" Cursor="Hand" MouseLeftButtonUp="Clicked">
    <!-- D5 toast: title strip, then the work. The window height is fixed (ReminderService stacks by it), so long names end in an ellipsis. -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="TopBar" Height="30" Padding="12,0,6,0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource BrandMark}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="EasyPass" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CloseButton" Style="{StaticResource XButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource Close}" ToolTip="{DynamicResource Close}" Click="Clicked">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" />
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="14,12,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{StaticResource GlyphPartial}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,12,0"
                       AutomationProperties.Name="{DynamicResource TodoUnfinished}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock x:Name="Heading" FontWeight="SemiBold" Foreground="{StaticResource WarnInkBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TaskText" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CustomerText" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LoginText" FontSize="12" Style="{StaticResource NumText}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
