<Window x:Class="EasyPass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyPass" Width="1100" Height="720" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}"
        Activated="Window_Activated" Closing="Window_Closing">
    <Grid>

        <!-- 1. Kurulum -->
        <ScrollViewer x:Name="SetupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Margin="32" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource SetupWelcome}" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,24"
                           Text="{DynamicResource SetupIntro}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SetupNewTitle}" Style="{StaticResource Heading}" />
                            <TextBlock Text="{DynamicResource SetupLocation}" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button Content="{DynamicResource Pick}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="PickNewPath_Click" />
                                <TextBox x:Name="NewPathBox" IsReadOnly="True" />
                            </DockPanel>
                            <TextBlock Text="{DynamicResource NewMasterLabel}" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="NewPassword1" />
                            <TextBlock Text="{DynamicResource MasterRepeat}" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="NewPassword2" />
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,12,0,0"
                                       Text="{DynamicResource MasterWarning}" />
                            <Button Content="{DynamicResource CreateVault}" Style="{StaticResource AccentButton}" Margin="0,16,0,0" Click="CreateVault_Click" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SetupOpenTitle}" Style="{StaticResource Heading}" />
                            <TextBlock Text="{DynamicResource VaultFile}" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button Content="{DynamicResource Pick}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="PickOpenPath_Click" />
                                <TextBox x:Name="OpenPathBox" IsReadOnly="True" />
                            </DockPanel>
                            <TextBlock Text="{DynamicResource MasterPassword}" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="OpenPassword" />
                            <Button Content="{DynamicResource Open}" Style="{StaticResource AccentButton}" Margin="0,16,0,0" Click="OpenVault_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="SetupError" Style="{StaticResource Error}" />
                <Button x:Name="SetupCancel" Content="{DynamicResource Cancel}" HorizontalAlignment="Left" Margin="0,16,0,0"
                        Visibility="Collapsed" Click="SetupCancel_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Kilit -->
        <Grid x:Name="LockPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LockTitle}" Style="{StaticResource Title}" />
                    <TextBlock x:Name="LockPath" Style="{StaticResource Secondary}" FontSize="12" />
                    <TextBlock Text="{DynamicResource MasterPassword}" Style="{StaticResource Label}" Margin="0,20,0,4" />
                    <PasswordBox x:Name="LockPassword" KeyDown="LockPassword_KeyDown" />
                    <TextBlock x:Name="LockError" Style="{StaticResource Error}" />
                    <Button Content="{DynamicResource Open}" Style="{StaticResource AccentButton}" Margin="0,16,0,0" Click="Unlock_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Ana ekran -->
        <Grid x:Name="MainPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <DockPanel>
                    <TextBlock Text="EasyPass" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,24,0" />
                    <Button Content="{DynamicResource Settings}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Settings_Click" />
                    <Button Content="{DynamicResource NewEntry}" DockPanel.Dock="Right" Margin="16,0,0,0" Style="{StaticResource AccentButton}" Click="NewEntry_Click" />
                    <Grid MaxWidth="520" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" Padding="12,0" TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="{DynamicResource SearchHint}" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Top" Style="{StaticResource Secondary}" FontSize="12" Margin="20,12,20,0" />
                        <ListBox x:Name="EntryList" SelectionChanged="EntryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="110" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Text="{Binding Site, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Site, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" TextBlock.FontSize="12" TextBlock.Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock Text="{Binding Username, Mode=OneWay}" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding Extra1, Mode=OneWay}" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding Extra2, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" Margin="32,24" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="EditTitle" Text="{DynamicResource NewEntry}" Style="{StaticResource Title}" />
                        <TextBlock Text="{DynamicResource Site}" Style="{StaticResource Label}" />
                        <ComboBox x:Name="SiteBox" IsEditable="True" />
                        <TextBlock x:Name="SiteError" Style="{StaticResource Error}" Margin="0,4,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource FirstName}" Style="{StaticResource Label}" />
                                <TextBox x:Name="FirstNameBox" />
                                <TextBlock Text="{DynamicResource Extra1}" Style="{StaticResource Label}" />
                                <TextBox x:Name="Extra1Box" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource LastName}" Style="{StaticResource Label}" />
                                <TextBox x:Name="LastNameBox" />
                                <TextBlock Text="{DynamicResource Extra2}" Style="{StaticResource Label}" />
                                <TextBox x:Name="Extra2Box" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Username}" Style="{StaticResource Label}" />
                        <TextBox x:Name="UsernameBox" />
                        <TextBlock Text="{DynamicResource Password}" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button Content="{DynamicResource Copy}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="CopyPassword_Click" />
                            <Button x:Name="ShowPasswordButton" Content="{DynamicResource Show}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="TogglePassword_Click" />
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" />
                                <TextBox x:Name="PasswordText" Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" Margin="0,16,0,0" />
                        <DockPanel Margin="0,16,0,0">
                            <Button Content="{DynamicResource Save}" Style="{StaticResource AccentButton}" MinWidth="120" Click="Save_Click" />
                            <Button x:Name="DeleteButton" Content="{DynamicResource Delete}" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Click="Delete_Click" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

    </Grid>
</Window>
