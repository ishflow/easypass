<Window x:Class="EasyPass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyPass.App"
        Title="EasyPass" Width="1100" Height="720" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}"
        Activated="Window_Activated" Closing="Window_Closing">
    <Window.Resources>
        <local:EntryMarksConverter x:Key="EntryMarks" />
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource Error}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- eklentinin adsız eklediği kayıtta kullanıcı adı görünsün -->
        <Style x:Key="EntryName" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Text" Value="{Binding FullName, Mode=OneWay}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FullName, Mode=OneWay}" Value="">
                    <Setter Property="Text" Value="{Binding Username, Mode=OneWay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A long name wraps and the box grows, it is never cut -->
        <Style x:Key="NameBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid>

        <!-- 1. Kurulum -->
        <ScrollViewer x:Name="SetupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Margin="32" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource SetupWelcome}" Style="{StaticResource Title}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,24"
                           Text="{DynamicResource SetupIntro}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="{DynamicResource CreateVault}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="CreateVault_Click" />
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SetupNewTitle}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource SetupLocation}" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button Content="{DynamicResource Pick}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="PickNewPath_Click" />
                                    <TextBox x:Name="NewPathBox" IsReadOnly="True" Background="{StaticResource Surface2Brush}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,12,0,0"
                                           Text="{DynamicResource NoPasswordNote}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="{DynamicResource Open}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenVault_Click" />
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SetupOpenTitle}" Style="{StaticResource Heading}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource VaultFile}" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button Content="{DynamicResource Pick}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="PickOpenPath_Click" />
                                    <TextBox x:Name="OpenPathBox" IsReadOnly="True" Background="{StaticResource Surface2Brush}" />
                                </DockPanel>
                                <TextBlock Text="{DynamicResource OldMasterOptional}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                <PasswordBox x:Name="OpenPassword" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="SetupError" Style="{StaticResource Error}" />
                <Button x:Name="SetupCancel" Content="{DynamicResource Cancel}" HorizontalAlignment="Left" Margin="0,16,0,0"
                        Visibility="Collapsed" Click="SetupCancel_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Kilit -->
        <Grid x:Name="LockPanel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LockTitle}" Style="{StaticResource Title}" TextWrapping="Wrap" />
                    <TextBlock x:Name="LockPath" Style="{StaticResource Secondary}" FontSize="12" />
                    <TextBlock Text="{DynamicResource LockOnceHint}" Style="{StaticResource Secondary}" Margin="0,12,0,0" />
                    <TextBlock Text="{DynamicResource MasterPassword}" Style="{StaticResource FieldLabel}" Margin="0,20,0,4" />
                    <PasswordBox x:Name="LockPassword" KeyDown="LockPassword_KeyDown" />
                    <TextBlock x:Name="LockError" Style="{StaticResource Error}" />
                    <Button Content="{DynamicResource Open}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Unlock_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Ana ekran -->
        <Grid x:Name="MainPanel" Visibility="Collapsed">
            <TabControl x:Name="Tabs" SelectedIndex="0" Padding="116,0,48,0" SelectionChanged="Tabs_SelectionChanged">
                <TabItem Header="{DynamicResource TabClients}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Pane}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                                    <Button Content="{DynamicResource NewEntry}" DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Click="NewEntry_Click" />
                                    <Grid>
                                        <TextBox x:Name="SearchBox" Height="32" Padding="26,0,4,0" AutomationProperties.Name="{DynamicResource SearchHint}" TextChanged="SearchBox_TextChanged" />
                                        <Path Data="M10.3,6 A4.3,4.3 0 1 1 1.7,6 A4.3,4.3 0 1 1 10.3,6 M9.3,9.3 L12.5,12.5" Width="14" Height="14" Margin="9,0,0,0" HorizontalAlignment="Left"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
                                        <TextBlock Text="{DynamicResource SearchHint}" FontSize="12" Margin="29,0,2,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,0,16,6">
                                    <TextBlock x:Name="MonthText" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="CountText" Style="{StaticResource Secondary}" FontSize="12" />
                                </DockPanel>
                                <ListBox x:Name="EntryList" Padding="6,0" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="EntryList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Background="Transparent">
                                                <DockPanel.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource EntryName}" MaxWidth="360" HorizontalAlignment="Left" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Site, Mode=OneWay}" Margin="0,0,12,0" />
                                                            <TextBlock Text="{Binding Extra1, Mode=OneWay}" Margin="0,0,12,0" />
                                                            <TextBlock Text="{Binding Extra2, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel.ToolTip>
                                                <ItemsControl DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Focusable="False"
                                                              ItemsSource="{Binding Converter={StaticResource EntryMarks}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding Glyph}" Style="{StaticResource StatusGlyph}" Margin="4,0,0,0"
                                                                   ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource EntryName}" FontWeight="Medium" />
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Username, Mode=OneWay}" Style="{StaticResource NumText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock DockPanel.Dock="Left" Text="·" FontSize="12" Margin="6,0" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Site, Mode=OneWay}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- aynı müşteri birçok sitede: site satırda görünmeli -->
                                                        <TextBlock Text="{Binding Site, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Pane}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,16,20,12">
                                    <StackPanel>
                                        <TextBlock x:Name="EditTitle" Text="{DynamicResource NewEntry}" Style="{StaticResource Title}" Margin="0" TextWrapping="Wrap" />
                                        <WrapPanel x:Name="EditSub" Margin="0,4,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="EditLogin" Style="{StaticResource NumText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Ellipse Width="3" Height="3" Margin="10,0" VerticalAlignment="Center" Fill="{StaticResource Line2Brush}" />
                                            <TextBlock x:Name="EditSite" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer x:Name="EditScroll" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <local:EntryWorkView x:Name="WorkPage" />
                                        <StackPanel Margin="20,14">
                                            <!-- FormGrid_SizeChanged moves these eight by position: keep their order -->
                                            <Grid x:Name="FormGrid" SizeChanged="FormGrid_SizeChanged">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource LastName}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="LastNameBox" Style="{StaticResource NameBox}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource FirstName}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="FirstNameBox" Style="{StaticResource NameBox}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource Site}" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox x:Name="SiteBox" IsEditable="True" />
                                                    <TextBlock x:Name="SiteError" Style="{StaticResource FieldError}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource Username}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="UsernameBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource Password}" Style="{StaticResource FieldLabel}" />
                                                    <DockPanel>
                                                        <Button Content="{DynamicResource Copy}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="CopyPassword_Click" />
                                                        <Button x:Name="ShowPasswordButton" Content="{DynamicResource Show}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="TogglePassword_Click" />
                                                        <Grid>
                                                            <PasswordBox x:Name="PasswordBox" />
                                                            <TextBox x:Name="PasswordText" Visibility="Collapsed" />
                                                        </Grid>
                                                    </DockPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource Extra1}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="Extra1Box" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource Extra2}" Style="{StaticResource FieldLabel}" />
                                                    <TextBox x:Name="Extra2Box" />
                                                </StackPanel>
                                                <DockPanel Grid.Row="2" Grid.Column="4" Margin="0,0,0,10" VerticalAlignment="Bottom">
                                                    <Button Content="{DynamicResource Save}" Click="Save_Click" />
                                                    <Button x:Name="DeleteButton" Content="{DynamicResource Delete}" Style="{StaticResource DangerButton}" Height="26" Padding="10,0" FontSize="12"
                                                            HorizontalAlignment="Right" Margin="6,0,0,0" Click="Delete_Click" />
                                                </DockPanel>
                                            </Grid>
                                            <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                        <!-- Sign-up form details from the site (extension "save" prompt), read-only -->
                                        <Border x:Name="SiteFieldsPanel" Visibility="Collapsed" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource SiteFields}" Style="{StaticResource Section}" Margin="0,0,0,6" />
                                                <StackPanel x:Name="SiteFieldsList" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Month by month, newest first; read-only -->
                                        <Border x:Name="HistoryPanel" Visibility="Collapsed" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource History}" Style="{StaticResource Section}" Margin="0,0,0,6" />
                                                <ItemsControl x:Name="HistoryList" Focusable="False" ItemTemplate="{StaticResource MonthMarksTemplate}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource TabTodo}">
                    <local:TodoView x:Name="TodoPage" />
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource TabNotifications}" />
                            <!-- negative margins: the badge must not make this header taller, or its label sits off the other tabs' baseline -->
                            <Border x:Name="DueBadge" Visibility="Collapsed" Style="{StaticResource Badge}" Margin="6,-2,0,-2" VerticalAlignment="Center">
                                <TextBlock x:Name="DueCount" Style="{StaticResource BadgeText}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <local:NotificationsView x:Name="NotificationsPage" />
                </TabItem>
                <TabItem Header="{DynamicResource TabTasks}">
                    <local:TasksView x:Name="TasksPage" />
                </TabItem>
            </TabControl>
            <StackPanel Orientation="Horizontal" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,0,0,0" IsHitTestVisible="False">
                <Image Source="{StaticResource BrandMark}" Width="18" Height="18" Margin="0,0,8,0" />
                <TextBlock Text="EasyPass" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Click="Settings_Click">
                <Path Data="{StaticResource GearIcon}" Width="16" Height="16" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
        </Grid>

    </Grid>
</Window>
