<Window x:Class="EasyPass.App.PickTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WorkAddTitle}" Width="440" Height="420" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel Background="{StaticResource SurfaceBrush}">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource WorkAddTitle}" Style="{StaticResource Heading}" TextWrapping="Wrap" Margin="24,20,24,8" />
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,14,24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Cancel}" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="SaveButton" Content="{DynamicResource Save}" Style="{StaticResource AccentButton}" IsEnabled="False" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Boxes" Margin="24,0,24,8" />
        </ScrollViewer>
    </DockPanel>
</Window>
